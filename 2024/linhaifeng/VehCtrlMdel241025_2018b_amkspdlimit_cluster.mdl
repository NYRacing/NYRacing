  state {
    id			    349
    labelString		    "eML_blk_kernel()"
    position		    [18 64.5 118 66]
    fontSize		    12
    chart		    348
    treeNode		    [348 0 0 0]
    superState		    SUBCHART
    subviewer		    348
    ssIdNumber		    1
    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [Wtarget,btarget] = fcn(Vx_mps,WhlStrAng,lf,lr,m,Car,Caf,u,Ax_mpss)\nWdes = Vx_mps*WhlSt"
      "rAng/(lf+lr+(m*Vx_mps*Vx_mps*(lr*Car-lf*Caf)/Caf/Car/(lr+lf)/2));\nWu = 0.8*u*9.8/Ax_mpss;\ntemp = min(abs(Wu),a"
      "bs(Wdes));\n    Wtarget = 0.8*temp*sign(Wdes);\n%     Wtarget = Wdes;\n\nbdes = (lr-lf*m*Vx_mps*Vx_mps/Car/(lf+l"
      "r)/2)*WhlStrAng/(lr+lf+m*Vx_mps*Vx_mps*(lr*Car-lf*Caf)/Car/Caf/(lf+lr)/2);\nbu = atan(0.02*u*9.8);\nif abs(bdes)"
      "<=bu\nbtarget = bdes;\nelse\n    btarget = bu*sign(bdes);\nend"
    }
  }
