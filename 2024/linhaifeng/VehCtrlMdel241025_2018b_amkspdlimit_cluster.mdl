    eml {
      isEML		      1
      script		      "function [Fz1,Fz2,Fz3,Fz4] = fcn(ax,ay,h,lfw,lrw,lf,lr,m)\ng = 9.8;\n\nFz1 = (lr/(lf+lr))*(0.5*m*"
      "g-m*ay*h/lfw)-0.5*m*ax*h/(lf+lr);\nFz2 = (lr/(lf+lr))*(0.5*m*g+m*ay*h/lfw)-0.5*m*ax*h/(lf+lr);\nFz3 = (lr/(lf+lr"
      "))*(0.5*m*g-m*ay*h/lrw)+0.5*m*ax*h/(lf+lr);\nFz4 = (lr/(lf+lr))*(0.5*m*g+m*ay*h/lrw)+0.5*m*ax*h/(lf+lr);\n"
    }
  }
