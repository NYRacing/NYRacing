    type		    FUNC_STATE
    decomposition	    CLUSTER_STATE
    eml {
      isEML		      1
      script		      "function [T1max,T2max,T34max] = fcn(Fz1,Fz2,Fz3,Fz4, TamkFL_max,TamkFR_max, Temrax_max,ay_g,Rt,i1"
      ",i2,u)\ng = 9.8;\n\nFx1 = sqrt(power(Fz1*u,2)-power(Fz1*ay_g/g,2));\nFx2 = sqrt(power(Fz2*u,2)-power(Fz2*ay_g/g,"
      "2));\nFx3 = sqrt(power(Fz3*u,2)-power(Fz3*ay_g/g,2));\nFx4 = sqrt(power(Fz4*u,2)-power(Fz4*ay_g/g,2));\n\n\nT1ma"
      "x = min(Fx2*Rt/i1,TamkFR_max);\nT2max = min(Fx1*Rt/i1,TamkFL_max);\nT34max = min(min(Fx4,Fx3)*Rt/i2,Temrax_max);"
      "\n"
    }
  }
